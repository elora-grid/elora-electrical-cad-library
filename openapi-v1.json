    "/deliveries": {
      "post": {
        "operationId": "prepareCadDownloads",
        "summary": "Plan 1–50 independent downloads synchronously; safe to retry",
        "description": "Read only. Creates no account, conversion, project, charge or email. Customer price is zero.",
        "parameters": [],
        "security": [
          {},
          {
            "RegistrationBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Delivery"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input; correct parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or unpublished artifact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Capacity limit; obey Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Selection"
              }
            }
          }
        },
        "x-idempotency": "No persistent state or packaging jobs. selection_id hashes the sorted set; current availability is revalidated on every request."
      }
    },
    "/artifacts/{id}/download": {
      "get": {
        "operationId": "downloadCadArtifact",
        "summary": "Download an already prepared artifact; never starts conversion",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 401,
              "description": "artifact_id returned by the manifest; URL-encode it."
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{8,80}$"
            },
            "description": "Reuse for the same artifact for up to five minutes. Conflicting/expired keys return 409. Retries recheck publication and do not double-reserve quotas. Without a key, identical requests deduplicate within a five-minute bucket."
          }
        ],
        "security": [
          {},
          {
            "RegistrationBearer": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to approved public file or, for HTML clients, the fixed app account screen.",
            "headers": {
              "X-CAD-Allowance-Tier": {
                "schema": {
                  "type": "string"
                },
                "description": "Current allowance; reset is seconds until 00:00 UTC."
              },
              "X-CAD-Files-Limit": {
                "schema": {
                  "type": "string"
                },
                "description": "Current allowance; reset is seconds until 00:00 UTC."
              },
              "X-CAD-Files-Remaining": {
                "schema": {
                  "type": "string"
                },
                "description": "Current allowance; reset is seconds until 00:00 UTC."
              },
              "X-CAD-Bytes-Limit": {
                "schema": {
                  "type": "string"
                },
                "description": "Current allowance; reset is seconds until 00:00 UTC."
              },
              "X-CAD-Bytes-Remaining": {
                "schema": {
                  "type": "string"
                },
                "description": "Current allowance; reset is seconds until 00:00 UTC."
              },
              "X-CAD-Allowance-Reset": {
                "schema": {
                  "type": "string"
                },
                "description": "Current allowance; reset is seconds until 00:00 UTC."
              }
            }
          },
          "401": {
            "description": "Anonymous trial exhausted: register once. Exclusive conversions always require verified account/OAuth.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "1,000-file free month exhausted. Sign into an existing active paid Elora Grid plan; review actual offers at /settings#billing. No automatic charge."
          },
          "404": {
            "description": "Withdrawn or unknown file"
          },
          "409": {
            "description": "Awaiting access review"
          },
          "429": {
            "description": "10,000-file paid month, daily byte budget, or global delivery capacity exhausted. Honour Retry-After."
          },
          "503": {
            "description": "Storage or exclusive account delivery unavailable"
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "getCadCapabilities",
        "summary": "Discover published counts, formats, catalogue identity, limits and access policy.",
        "security": [],
        "responses": {
          "200": {
            "description": "Capabilities of this deployed catalogue. Counts exclude held candidates.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "429": {
            "description": "Capacity limit; obey Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/allowance": {
      "get": {
        "operationId": "getCadAllowance",
        "summary": "Read remaining daily allowance before delivery; no quota consumption",
        "security": [
          {},
          {
            "RegistrationBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current principal allowance, fixed policy and UTC reset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Quota status unavailable; no zero-usage claim"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Access": {
        "type": "object",
        "properties": {
          "policy_version": {
            "type": "integer",
            "const": 1
          },
          "access": {
            "enum": [
              "public",
              "cad_account",
              "review_required",
              "unavailable"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "policy_version",
          "access",
          "reason"
        ]
      },
      "Item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "part_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "product",
              "family",
              "library",
              "configurator",
              "drawing"
            ]
          },
          "category": {
            "type": "string"
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "configuration_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical_url": {
            "type": "string"
          },
          "match_reason": {
            "type": "string",
            "enum": [
              "normalised_part_number",
              "catalogue_text",
              "browse"
            ]
          },
          "part_number_basis": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "filename_reference",
              "catalogue_reference",
              null
            ]
          }
        },
        "required": [
          "id",
          "name",
          "manufacturer",
          "part_number",
          "kind",
          "category",
          "formats",
          "configuration_note",
          "canonical_url"
        ]
      },
      "Artifact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "provenance": {
            "enum": [
              "manufacturer_source",
              "prepared_conversion"
            ]
          },
          "geometry_kind": {
            "enum": [
              "unknown",
              "2d_drawing",
              "brep_solid",
              "surface_model",
              "mesh",
              "application_native",
              "reference_document"
            ]
          },
          "units": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "artifact_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "access": {
            "$ref": "#/components/schemas/Access"
          },
          "download_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "customer_price": {
            "type": "integer",
            "const": 0
          },
          "contained_formats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "download_format": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "archive_member": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "validation": {
            "type": [
              "object",
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "artifact_id",
          "name",
          "format",
          "purpose",
          "provenance",
          "geometry_kind",
          "units",
          "bytes",
          "artifact_sha256",
          "source_sha256",
          "access",
          "download_url",
          "customer_price"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "request_id": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              },
              "next_action": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "after_seconds": {
                    "type": "integer"
                  },
                  "catalogue_version": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "description": "Identity of the published catalogue. Pass it on subsequent pages; HTTP 409 requires restarting at page 1."
                  }
                }
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "DeliveryResult": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "authentication_required",
              "artifact_pending",
              "artifact_withdrawn",
              "temporarily_unavailable",
              "registration_required",
              "paid_plan_required",
              "allowance_reached",
              "selection_allowance_exceeded"
            ]
          },
          "format": {
            "type": "string"
          },
          "access": {
            "enum": [
              "public",
              "cad_account",
              "review_required",
              "unavailable"
            ]
          },
          "download_url": {
            "type": "string"
          },
          "next_action": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "after_seconds": {
                "type": "integer"
              }
            },
            "required": [
              "type"
            ]
          },
          "reason": {
            "type": "string"
          },
          "bytes": {
            "type": [
              "integer",
