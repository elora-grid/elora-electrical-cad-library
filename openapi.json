                "outline drawings"
              ]
            }
          },
          {
            "name": "market",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "US",
                "AU",
                "UK",
                "Europe",
                "EU"
              ]
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "product",
                "family",
                "library",
                "configurator",
                "drawing"
              ]
            }
          },
          {
            "name": "acquired",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "hosted",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "all",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "summary"
              ]
            }
          },
          {
            "name": "ids",
            "in": "query",
            "description": "Comma-separated catalogue IDs; up to 500.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "audit",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 24
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Equipment metadata or requested coverage audit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter or pagination value"
          }
        }
      }
    },
    "/tools/cad-library/entries/{asset}": {
      "get": {
        "operationId": "readOfficialCadSource",
        "summary": "Read an equipment source as JSON or Markdown",
        "parameters": [
          {
            "name": "asset",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+\\.(md|json)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Equipment provenance, file URLs, access requirements and configuration notes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Source entry not found"
          }
        }
      }
    }
  }
}
