{
  "openapi": "3.1.0",
  "info": {
    "title": "Elora Grid official CAD discovery",
    "version": "3.1.0",
    "description": "Free read-only discovery of official CAD sources. Metadata, official publisher routes and direct-site official CAD downloads with recorded rights status for USA, Australia, UK and Europe."
  },
  "servers": [
    {
      "url": "https://eloragrid.ai"
    }
  ],
  "paths": {
    "/tools/cad-library/download/{record}/{file}": {
      "get": {
        "operationId": "downloadOfficialCad",
        "summary": "Email registration required for CAD downloads; licences and delivery are recorded per file",
        "parameters": [
          {
            "name": "record",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Registered visitor: redirect to a five-minute signed attachment or official publisher route; use the stable site URL on later visits"
          },
          "307": {
            "description": "Enter email at the returned location to receive a file-specific seven-day download link on screen and by email; the private browser cookie remains compatible"
          },
          "404": {
            "description": "Unknown file, explicitly restricted file or revoked publication"
          },
          "503": {
            "description": "Storage temporarily unavailable; use the official publisher URL"
          }
        }
      }
    },
    "/tools/cad-library/catalogue.json": {
      "get": {
        "operationId": "searchOfficialCad",
        "summary": "Search source entries and official file URLs",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 160
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "switchgear",
                "breakers",
                "enclosures",
                "busbar",
                "protection",
                "automation",
                "wiring",
                "power-supplies",
                "thermal",
                "power-quality",
                "transformers",
                "generation",
                "generator-auxiliaries",
                "storage",
                "solar",
                "communications",
                "cable-management",
                "switchroom-services"
              ]
            }
          },
          {
            "name": "manufacturer",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "abb",
                "asco",
                "abtech",
                "alfen",
                "automationdirect",
                "avtron",
                "bopla",
                "balluff",
                "bender",
                "bosch-rexroth",
                "cubic",
                "carlo-gavazzi",
                "caterpillar",
                "chargepoint",
                "clevertronics",
                "comap",
                "cressall",
