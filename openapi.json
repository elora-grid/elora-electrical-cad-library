          "200": {
            "description": "Equipment metadata or requested coverage audit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "307": {
            "description": "Complete unfiltered catalogue served as a static JSON asset"
          },
          "400": {
            "description": "Invalid filter, pagination or oversized filtered response"
          }
        }
