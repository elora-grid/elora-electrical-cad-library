                "dagartech",
                "danfoss",
                "deep-sea-electronics",
                "dorman-smith",
                "eaton",
                "eaton-b-line",
                "eaton-crouse-hinds",
                "endress-hauser",
                "fg-wilson",
                "fantech",
                "fronius",
                "fuji-electric",
                "genelite",
                "generac",
                "greenheck",
                "hager",
                "hammond-manufacturing",
                "hammond-power-solutions",
                "hensel",
                "honeywell-notifier",
                "hubbell",
                "innio",
                "ipd",
                "ingeteam",
                "invertek-drives",
                "lovato-electric",
                "legrand",
                "legrand-australia",
                "libre-solar",
                "lithonia-lighting-acuity-brands",
                "littelfuse",
                "lucy-electric",
                "miratech",
                "mecc-alte",
                "mitsubishi-electric",
                "nhp",
                "nidec-leroy-somer",
                "obo-bettermann",
                "opw",
                "openenergymonitor",
                "puls",
                "panduit",
                "pepperl-fuchs",
                "pfannenberg",
                "phoenix-contact",
                "post-glover",
                "rehlko",
                "rittal",
                "rockwell-automation",
                "roxtec",
                "s-c-electric",
                "schurter",
                "sens",
                "sick",
                "sma",
                "stamford-avk",
                "stego",
                "saginaw-control-and-engineering",
                "schmersal",
                "schneider-electric",
                "schweitzer-engineering-laboratories",
                "siemens",
                "signify",
                "simplex",
                "socomec",
                "southern-states",
                "spelsberg",
                "sungrow",
                "tdk-lambda",
                "thycon",
                "terasaki",
                "tesla",
                "tramont",
                "vega",
                "victron-energy",
                "wago",
                "weidmuller",
                "westermo",
                "wilson-transformer-company",
                "wohner",
                "xtralis",
                "yaskawa",
                "zpas",
                "icotek",
                "ifm",
                "mtu-rolls-royce",
                "nvent-erico",
                "nvent-eriflex",
                "nvent-hoffman"
              ]
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "2D CAD",
                "2D drawings",
                "3D CAD",
                "3D drawings",
                "AVEVA",
                "AutoCAD",
                "BIM",
                "BRD",
                "CAD",
                "CAD package",
                "CSV",
                "DGN",
                "DWFX",
                "DWG",
                "DXF",
                "EDZ",
                "EPLAN",
                "EPLAN EDZ",
                "FCSTD",
                "IES",
                "IGES",
                "IGS",
                "Intergraph",
                "KICAD_PCB",
                "KICAD_SCH",
                "LDT",
                "PDF",
